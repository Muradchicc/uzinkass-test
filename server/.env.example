# Apps Script Web App havolasi (https://script.google.com/macros/s/.../exec)
# Bo'sh qoldirilsa server fake-data.json dagi sinov savollari bilan ishlaydi.
APPS_SCRIPT_URL=

# apps-script/Code.gs ichidagi TOKEN bilan bir xil bo'lishi kerak
APPS_SCRIPT_TOKEN=

# Server porti (80 — standart, havolada port yozilmaydi)
PORT=80

# Savollar soni va bir savolga beriladigan vaqt (soniya).
# Jadvaldagi "_Sozlamalar" listida ko'rsatilgan bo'lsa, o'sha qiymatlar ustun turadi.
QUESTION_COUNT=10
SECONDS_PER_QUESTION=60

# https:// deb yozilganda http:// ga yo'naltiruvchi port (0 - o'chirilgan)
HTTPS_REDIRECT_PORT=443
