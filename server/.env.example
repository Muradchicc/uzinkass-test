# Apps Script Web App havolasi (https://script.google.com/macros/s/.../exec)
# Bo'sh qoldirilsa server fake-data.json dagi sinov savollari bilan ishlaydi.
APPS_SCRIPT_URL=

# apps-script/Code.gs ichidagi TOKEN bilan bir xil bo'lishi kerak
APPS_SCRIPT_TOKEN=

# Server porti (80 — standart, havolada port yozilmaydi)
PORT=80

# Bitta testdagi savollar soni
QUESTION_COUNT=10
